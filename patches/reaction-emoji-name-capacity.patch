+package app
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+// BenchmarkReactionEmojiHistory prepares stored, ordered pages with warm reaction
+// caches and priority reads enabled. No files or remote links are included.
+func BenchmarkReactionEmojiHistory(b *testing.B) {
+	th := Setup(b).InitBasic(b)
+	if !th.App.IsPostPriorityEnabled() {
+		b.Fatal("priority reads must be enabled")
+	}
+	th.App.UpdateConfig(func(cfg *model.Config) { *cfg.ServiceSettings.EnableLinkPreviews = false })
+	for _, size := range []int{1, 60} {
+		b.Run(fmt.Sprintf("posts=%d", size), func(b *testing.B) {
+			list := model.NewPostList()
+			for range size {
+				post, err := th.App.Srv().Store().Post().Save(th.Context, &model.Post{ChannelId: th.BasicChannel.Id, UserId: th.BasicUser.Id, Message: "reaction history"})
+				if err != nil {
+					b.Fatal(err)
+				}
+				for _, emoji := range []string{"smile", "heart", "tada"} {
+					_, err := th.App.Srv().Store().Reaction().Save(&model.Reaction{PostId: post.Id, ChannelId: post.ChannelId, UserId: post.UserId, EmojiName: emoji})
+					if err != nil {
+						b.Fatal(err)
+					}
+				}
+				post.HasReactions = true
+				list.AddPost(post)
+				list.AddOrder(post.Id)
+			}
+			check := func(result *model.PostList) {
+				if len(result.Order) != size || len(result.Posts) != size {
+					b.Fatal("incorrect history order")
+				}
+				for i, id := range list.Order {
+					if result.Order[i] != id {
+						b.Fatal("changed order")
+					}
+					p := result.Posts[id]
+					if p == nil || p.Metadata == nil || len(p.Metadata.Reactions) != 3 {
+						b.Fatal("missing reaction metadata")
+					}
+					for _, r := range p.Metadata.Reactions {
+						if r.PostId != id || r.DeleteAt != 0 || r.UserId != th.BasicUser.Id || r.ChannelId != th.BasicChannel.Id {
+							b.Fatal("incorrect reaction metadata")
+						}
+					}
+				}
+			}
+			check(th.App.PreparePostListForClient(th.Context, list))
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				check(th.App.PreparePostListForClient(th.Context, list))
+			}
+		})
+	}
+}
diff --git a/server/channels/app/reaction_emoji_names_test.go b/server/channels/app/reaction_emoji_names_test.go
new file mode 100644
index 000000000000..84ab6fa85df5
--- /dev/null
+++ b/server/channels/app/reaction_emoji_names_test.go
@@ -0,0 +1,55 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package app
+
+import (
+	"fmt"
+	"slices"
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+)
+
+func BenchmarkReactionEmojiNames(b *testing.B) {
+	for _, text := range []bool{false, true} {
+		for _, count := range []int{0, 1, 3, 12, 60} {
+			b.Run(fmt.Sprintf("text=%t/reactions=%d", text, count), func(b *testing.B) {
+				post := &model.Post{Message: "reaction history"}
+				var want []string
+				if text {
+					post.Message = ":shared: :text:"
+					want = []string{"shared", "text"}
+				}
+				reactions := make([]*model.Reaction, count)
+				for i := range reactions {
+					name := fmt.Sprintf("reaction_%02d", i%3)
+					reactions[i] = &model.Reaction{EmojiName: name}
+					if !slices.Contains(want, name) {
+						want = append(want, name)
+					}
+				}
+				slices.Sort(want)
+				check := func(got []string) {
+					if !slices.Equal(got, want) || (got == nil) != (want == nil) {
+						b.Fatalf("got %#v, want %#v", got, want)
+					}
+					for i, r := range reactions {
+						if r.EmojiName != fmt.Sprintf("reaction_%02d", i%3) {
+							b.Fatal("mutated reaction")
+						}
+					}
+				}
+				check(getEmojiNamesForPost(post, reactions, true))
+				b.ReportAllocs()
+				b.ResetTimer()
+				var got []string
+				for range b.N {
+					got = getEmojiNamesForPost(post, reactions, true)
+				}
+				b.StopTimer()
+				check(got)
+			})
+		}
+	}
+}
