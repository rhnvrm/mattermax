Date: Sat, 14 Nov 2026 19:19:36 +0530
Subject: [PATCH] perf: reserve space for reaction emoji names

Reserve capacity for known reaction names before appending them. Keep text extraction, sorting and duplicate removal unchanged.

Mattermax-Patch: reaction-emoji-name-capacity.patch
---
 server/channels/app/post_metadata.go          |  2 +
 .../app/reaction_emoji_history_test.go        | 66 +++++++++++++++++++
 .../channels/app/reaction_emoji_names_test.go | 55 ++++++++++++++++
 3 files changed, 123 insertions(+)
 create mode 100644 server/channels/app/reaction_emoji_history_test.go
 create mode 100644 server/channels/app/reaction_emoji_names_test.go

diff --git a/server/channels/app/post_metadata.go b/server/channels/app/post_metadata.go
index 8021a3f38709..f001ce80915b 100644
--- a/server/channels/app/post_metadata.go
+++ b/server/channels/app/post_metadata.go
@@ -12,6 +12,7 @@ import (
 	"net/http"
 	"net/url"
 	"regexp"
+	"slices"
 	"strconv"
 	"strings"
 	"time"
@@ -767,6 +768,7 @@ func getEmojiNamesForPost(post *model.Post, reactions []*model.Reaction, mmBlock
 	for _, s := range allStrings {
 		names = append(names, getEmojiNamesForString(s)...)
 	}
+	names = slices.Grow(names, len(reactions))
 	for _, reaction := range reactions {
 		names = append(names, reaction.EmojiName)
 	}
diff --git a/server/channels/app/reaction_emoji_history_test.go b/server/channels/app/reaction_emoji_history_test.go
new file mode 100644
index 000000000000..5a48aa960280
--- /dev/null
+++ b/server/channels/app/reaction_emoji_history_test.go
@@ -0,0 +1,66 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
